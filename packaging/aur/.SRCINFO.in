pkgbase = @APP_SLUG@-bin
	pkgdesc = @APP_DESCRIPTION@
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/@GITHUB_REPO@
	arch = x86_64
	license = @APP_LICENSE@
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = fontconfig
	depends = freetype2
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk3
	depends = libepoxy
	depends = pango
	depends = hicolor-icon-theme
	optdepends = ffmpeg: Audio decoding support
	provides = @APP_SLUG@=@VERSION@
	conflicts = @APP_SLUG@
	options = !strip
	source_x86_64 = @APP_SLUG@-bin-@VERSION@.deb::https://github.com/@GITHUB_REPO@/releases/download/@VERSION@/@APP_SLUG@-linux-@VERSION@-amd64.deb
	sha256sums_x86_64 = @DEB_SHA256@

pkgname = @APP_SLUG@-bin
